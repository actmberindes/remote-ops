{
  "name": "remote-ops-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Windows background agent for scheduled screenshots and near-live desktop view",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "pair": "node src/pairing.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/remote-ops-agent.exe"
  },
  "dependencies": {
    "screenshot-desktop": "^1.15.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": ["node_modules/screenshot-desktop/lib/**/*"]
  }
}
